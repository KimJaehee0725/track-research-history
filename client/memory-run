#!/usr/bin/env bash
# Start a disposable Docker container with only the scoped research-memory
# connection material it needs.  No host path, host name, or private key is
# baked into this wrapper or an image.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  memory-run --profile NAME [connection options] [Docker options] -- IMAGE [COMMAND ...]
  memory-run --project PROJECT --identity KEY [connection options] [Docker options] -- IMAGE [COMMAND ...]

Profile option:
  --profile NAME             Resolve project, key path, and connection from a local memctl profile

Required without --profile:
  --project PROJECT          Project scope exposed to the container
  --identity KEY             SSH private key mounted read-only into the container

Connection options:
  --host HOST                SSH host (or set it in --config)
  --user USER                SSH user
  --port PORT                SSH port
  --config FILE              Non-secret memctl JSON config, mounted read-only
  --ssh-config FILE          OpenSSH config, mounted read-only
  --known-hosts FILE         known_hosts file, mounted read-only

Container options:
  --docker-arg ARG           One additional docker run argument; may repeat
  --tty                      Add -it for an interactive shell
  --keep                     Do not add --rm
  --client-dir DIR           Directory containing memctl.py (default: this directory)
  --container-dir DIR        Safe in-container mount directory (default: /run/research-memory)
  --container-client-dir DIR In-container memctl directory (default: /opt/research-memory-client)

Place -- before IMAGE. The image needs Python 3 and an OpenSSH client. Inside
the container, use:
  python "$RESEARCH_MEMORY_MEMCTL" note list
EOF
}

die() {
  printf 'memory-run: %s\n' "$*" >&2
  exit 2
}

need_value() {
  [[ $# -ge 2 && -n "$2" ]] || die "missing value for $1"
}

absolute_file() {
  local candidate="$1"
  if [[ "$candidate" == "~/"* ]]; then
    candidate="$HOME/${candidate:2}"
  fi
  [[ -f "$candidate" ]] || die "file does not exist: $candidate"
  [[ "$candidate" != *$'\n'* && "$candidate" != *,* ]] || die "file path contains an unsupported character"
  (
    cd -P -- "$(dirname -- "$candidate")"
    printf '%s/%s\n' "$(pwd -P)" "$(basename -- "$candidate")"
  )
}

absolute_dir() {
  local candidate="$1"
  [[ -d "$candidate" ]] || die "directory does not exist: $candidate"
  [[ "$candidate" != *$'\n'* && "$candidate" != *,* ]] || die "directory path contains an unsupported character"
  (
    cd -P -- "$candidate"
    pwd -P
  )
}

container_path() {
  local candidate="$1"
  [[ "$candidate" == /* && "$candidate" != *$'\n'* && "$candidate" != *,* ]] || \
    die "container mount path must be an absolute path without commas"
  printf '%s\n' "${candidate%/}"
}

default_profile_config() {
  if [[ -n "${MEMORY_CONFIG:-}" ]]; then
    printf '%s\n' "$MEMORY_CONFIG"
  elif [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    printf '%s/research-memory/client.json\n' "$XDG_CONFIG_HOME"
  else
    printf '%s/.config/research-memory/client.json\n' "$HOME"
  fi
}

profile_value() {
  local field="$1"
  local optional="${2:-0}"
  local value
  local -a command=(
    python3 "$client_dir/profiles.py" get
    --config "$config" --profile "$profile" --field "$field"
  )
  if [[ "$optional" == "1" ]]; then
    command+=(--optional)
  fi
  if ! value="$("${command[@]}")"; then
    return 2
  fi
  if [[ -z "$value" && "$optional" == "1" ]]; then
    return 1
  fi
  if [[ -z "$value" || "$value" == *$'\n'* ]]; then
    printf "memory-run: profile '%s' has an invalid '%s' value\n" "$profile" "$field" >&2
    return 2
  fi
  printf '%s\n' "$value"
}

project=""
identity=""
profile=""
host=""
ssh_user=""
ssh_port=""
config=""
ssh_config=""
known_hosts=""
client_dir="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
container_dir="/run/research-memory"
container_client_dir="/opt/research-memory-client"
remove_container=1
tty=0
declare -a docker_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --project)
      need_value "$@"
      project="$2"
      shift 2
      ;;
    --identity)
      need_value "$@"
      identity="$2"
      shift 2
      ;;
    --profile)
      need_value "$@"
      profile="$2"
      shift 2
      ;;
    --host)
      need_value "$@"
      host="$2"
      shift 2
      ;;
    --user)
      need_value "$@"
      ssh_user="$2"
      shift 2
      ;;
    --port)
      need_value "$@"
      ssh_port="$2"
      shift 2
      ;;
    --config)
      need_value "$@"
      config="$2"
      shift 2
      ;;
    --ssh-config)
      need_value "$@"
      ssh_config="$2"
      shift 2
      ;;
    --known-hosts)
      need_value "$@"
      known_hosts="$2"
      shift 2
      ;;
    --docker-arg)
      need_value "$@"
      docker_args+=("$2")
      shift 2
      ;;
    --tty)
      tty=1
      shift
      ;;
    --keep)
      remove_container=0
      shift
      ;;
    --client-dir)
      need_value "$@"
      client_dir="$2"
      shift 2
      ;;
    --container-dir)
      need_value "$@"
      container_dir="$2"
      shift 2
      ;;
    --container-client-dir)
      need_value "$@"
      container_client_dir="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      die "unknown option before image: $1 (use -- before IMAGE)"
      ;;
  esac
done

[[ $# -gt 0 ]] || die "an IMAGE is required after --"

client_dir="$(absolute_dir "$client_dir")"
[[ -f "$client_dir/memctl.py" ]] || die "client directory must contain memctl.py: $client_dir"
if [[ -n "$profile" ]]; then
  [[ "$profile" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || \
    die "profile must use only letters, numbers, dot, underscore, or hyphen"
  [[ -f "$client_dir/profiles.py" ]] || die "client directory must contain profiles.py: $client_dir"
  if [[ -z "$config" ]]; then
    config="$(default_profile_config)"
  fi
  if [[ -z "$project" ]]; then
    project="$(profile_value project)"
  fi
  if [[ -z "$identity" ]]; then
    identity="$(profile_value identity_file)"
  fi
  if [[ -z "$ssh_config" ]]; then
    if resolved_ssh_config="$(profile_value ssh_config 1)"; then
      ssh_config="$resolved_ssh_config"
    else
      profile_value_status=$?
      if [[ "$profile_value_status" -ne 1 ]]; then
        die "could not resolve profile '$profile' field 'ssh_config'"
      fi
    fi
  fi
  if [[ -z "$known_hosts" ]]; then
    if resolved_known_hosts="$(profile_value known_hosts 1)"; then
      known_hosts="$resolved_known_hosts"
    else
      profile_value_status=$?
      if [[ "$profile_value_status" -ne 1 ]]; then
        die "could not resolve profile '$profile' field 'known_hosts'"
      fi
    fi
  fi
fi

[[ -n "$project" ]] || die "--project is required unless --profile supplies one"
[[ "$project" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || \
  die "project must use only letters, numbers, dot, underscore, or hyphen"
[[ -n "$identity" ]] || die "--identity is required unless --profile supplies one; do not bake a key into the image"
[[ -n "$host" || -n "$config" ]] || die "provide --host, --config, or --profile"

identity="$(absolute_file "$identity")"
container_dir="$(container_path "$container_dir")"
container_client_dir="$(container_path "$container_client_dir")"

if [[ -n "$host" && ! "$host" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,252}$ ]]; then
  die "host must be an SSH host alias, hostname, or IP address"
fi
if [[ -n "$ssh_user" && ! "$ssh_user" =~ ^[A-Za-z_][A-Za-z0-9_-]{0,63}$ ]]; then
  die "SSH user contains unsupported characters"
fi
if [[ -n "$ssh_port" && ( ! "$ssh_port" =~ ^[0-9]+$ || "$ssh_port" -lt 1 || "$ssh_port" -gt 65535 ) ]]; then
  die "SSH port must be between 1 and 65535"
fi

if [[ -n "$config" ]]; then
  config="$(absolute_file "$config")"
fi
if [[ -n "$ssh_config" ]]; then
  ssh_config="$(absolute_file "$ssh_config")"
fi
if [[ -n "$known_hosts" ]]; then
  known_hosts="$(absolute_file "$known_hosts")"
fi

declare -a run=(docker run)
if [[ "$remove_container" -eq 1 ]]; then
  run+=(--rm)
fi
if [[ "$tty" -eq 1 ]]; then
  run+=(-it)
fi

# The only private material mounted by this wrapper is the explicitly supplied
# per-project key. Everything else is ordinary configuration or client code.
run+=(
  --mount "type=bind,src=$identity,dst=$container_dir/id_ed25519,readonly"
  --mount "type=bind,src=$client_dir,dst=$container_client_dir,readonly"
  -e "RESEARCH_MEMORY_PROJECT=$project"
  -e "RESEARCH_MEMORY_MEMCTL=$container_client_dir/memctl.py"
  -e "MEMORY_IDENTITY_FILE=$container_dir/id_ed25519"
)

if [[ -n "$profile" ]]; then
  run+=(
    -e "MEMORY_PROFILE=$profile"
    -e "RESEARCH_MEMORY_PROFILE=$profile"
  )
fi

if [[ -n "$host" ]]; then run+=(-e "MEMORY_HOST=$host"); fi
if [[ -n "$ssh_user" ]]; then run+=(-e "MEMORY_USER=$ssh_user"); fi
if [[ -n "$ssh_port" ]]; then run+=(-e "MEMORY_PORT=$ssh_port"); fi
if [[ -n "$config" ]]; then
  run+=(
    --mount "type=bind,src=$config,dst=$container_dir/client.json,readonly"
    -e "MEMORY_CONFIG=$container_dir/client.json"
  )
fi
if [[ -n "$ssh_config" ]]; then
  run+=(
    --mount "type=bind,src=$ssh_config,dst=$container_dir/ssh_config,readonly"
    -e "MEMORY_SSH_CONFIG=$container_dir/ssh_config"
  )
fi
if [[ -n "$known_hosts" ]]; then
  run+=(
    --mount "type=bind,src=$known_hosts,dst=$container_dir/known_hosts,readonly"
    -e "MEMORY_KNOWN_HOSTS=$container_dir/known_hosts"
  )
fi

if [[ ${#docker_args[@]} -gt 0 ]]; then
  run+=("${docker_args[@]}")
fi
run+=("$@")
exec "${run[@]}"

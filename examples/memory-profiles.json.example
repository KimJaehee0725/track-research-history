{
  "version": 1,
  "default_profile": "example-project-rw",
  "profiles": {
    "example-project-rw": {
      "project": "example-project",
      "host": "memory-server-alias",
      "user": "memory-rpc",
      "port": 22,
      "identity_file": "~/.ssh/research-memory-example-project-rw",
      "known_hosts": "~/.ssh/known_hosts",
      "ssh_options": [
        "IdentitiesOnly=yes",
        "StrictHostKeyChecking=yes"
      ],
      "timeout": 30
    }
  }
}

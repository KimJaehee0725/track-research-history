# Copy this file outside the repository, edit the paths, then load it in a
# shell with: set -a; . /path/to/research-memory.env; set +a
#
# This file contains only connection references. Never put a private key,
# passphrase, token, or research-note content in an environment file.
MEMORY_HOST=research-memory.example.edu
MEMORY_USER=memory-rpc
MEMORY_PORT=22
MEMORY_IDENTITY_FILE=/replace/with/your/.ssh/research-memory-alienlm
MEMORY_KNOWN_HOSTS=/replace/with/your/.ssh/known_hosts
MEMORY_SSH_OPTIONS='["IdentitiesOnly=yes","StrictHostKeyChecking=yes"]'
MEMORY_TIMEOUT=30

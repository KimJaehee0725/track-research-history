[Unit]
Description=Research Memory loopback management UI
Documentation=file:///opt/research-memory/deploy/README.md
After=network.target

[Service]
Type=simple
# The SSH forced-command endpoint and UI intentionally share this dedicated
# numeric service account so both use the same locked-down data directory.
User=memory-rpc
Group=memory-rpc
WorkingDirectory=/opt/research-memory
Environment=PYTHONPATH=/opt/research-memory/src:/opt/research-memory
Environment=MEMORY_DATA_DIR=/srv/research-memory
Environment=MEMORY_BIND_HOST=127.0.0.1
Environment=MEMORY_BIND_PORT=8787
ExecStart=/opt/research-memory/.venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=3
UMask=0077

# The service may read the checked-out application code but can only write its
# designated memory data root.  It intentionally has no public network bind.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/research-memory
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
